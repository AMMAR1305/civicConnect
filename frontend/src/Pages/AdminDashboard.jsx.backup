                    <p className="text-sm text-gray-600 mt-2">Registered in system</p>
                  </div>
                  <div className="bg-gradient-to-br from-red-50 to-pink-50 p-6 rounded-xl border-2 border-red-200">
                    <div className="flex items-center justify-between mb-3">
                      <h3 className="font-semibold text-gray-800">Critical Issues</h3>
                      <AlertOctagon className="w-6 h-6 text-red-600" />
                    </div>
                    <p className="text-4xl font-bold text-red-600">{slaBreaches.length || 0}</p>
                    <p className="text-sm text-gray-600 mt-2">SLA breached</p>
                  </div>
                </div>

                {/* Recent Communications - Activity Log */}
                <div className="bg-white p-6 rounded-xl border-2 border-gray-200">
                  <h3 className="text-lg font-semibold text-gray-800 mb-4">Recent Activity Log</h3>
                  <div className="space-y-3">
                    {auditLogs.length === 0 ? (
                      <div className="text-center py-8 text-gray-500">
                        <History className="w-12 h-12 text-gray-400 mx-auto mb-2" />
                        <p>No recent activity</p>
                      </div>
                    ) : (
                      auditLogs.slice(0, 5).map((log, index) => {
                        const getActivityColor = (action) => {
                          if (action.includes('Resolved')) return 'green';
                          if (action.includes('Assigned')) return 'blue';
                          if (action.includes('Status')) return 'orange';
                          return 'purple';
                        };
                        const color = getActivityColor(log.action);
                        const IconComponent = log.action.includes('Resolved') ? CheckCircle : 
                                             log.action.includes('Assigned') ? UserCog : 
                                             log.action.includes('Status') ? RefreshCw : History;
                        return (
                          <div key={index} className="flex items-start gap-4 p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                            <div className={`p-2 rounded-lg bg-${color}-100`}>
                              <IconComponent className={`w-5 h-5 text-${color}-600`} />
                            </div>
                            <div className="flex-1">
                              <div className="flex items-center justify-between mb-1">
                                <span className={`px-2 py-1 bg-${color}-100 text-${color}-700 rounded text-xs font-medium`}>
                                  {log.action}
                                </span>
                                <span className="text-xs text-gray-500">{log.timestamp}</span>
                              </div>
                              <p className="text-sm text-gray-700">{log.user} - {log.target}</p>
                            </div>
                          </div>
                        );
                      })
                    )}
                  </div>
                </div>
              </div>
            )}

            {activeTab === "reports" && (
